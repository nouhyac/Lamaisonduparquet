# ==========================================================
# La Maison du Parquet · réglages Apache / LiteSpeed (Hostinger)
# Sécurité, performance et référencement
# ==========================================================
Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off
FileETag None

RewriteEngine On

# --- 1. HTTPS forcé (activez d'abord le SSL gratuit dans hPanel) ---
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,NE,R=301]
# DOMAINE:début (géré par « npm run domaine -- votre-domaine.com », ne pas modifier à la main)
# lamaisonduparquet.org → www.lamaisonduparquet.org
RewriteCond %{HTTP_HOST} ^lamaisonduparquet\.org$ [NC]
RewriteRule ^ https://www.lamaisonduparquet.org%{REQUEST_URI} [L,NE,R=301]
# DOMAINE:fin

# La page d'erreur est toujours servie (évite les boucles)
RewriteRule ^404\.html$ - [L]

# --- 2. Seules les méthodes de lecture sont acceptées (site statique) ---
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$ [NC]
RewriteRule ^ - [F,L]

# --- 3. Fichiers cachés, sauvegardes et documents internes interdits ---
RewriteRule (^|/)\.(?!well-known/) - [F,L]
<FilesMatch "(?i)\.(md|txt~|bak|old|orig|save|swp|sql|log|ini|sh|zip|tar|gz|rar|7z|env|git|psd|config|lock|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(site\.webmanifest)$">
  Require all granted
</FilesMatch>

# --- 4. Blocage des robots d'attaque et des requêtes malveillantes courantes ---
RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (\.\./|\.\.%2F|%00|base64_encode|GLOBALS|_REQUEST|union.*select|concat\() [NC,OR]
RewriteCond %{REQUEST_URI} (wp-admin|wp-login|xmlrpc\.php|phpmyadmin|\.php$|/cgi-bin/) [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|masscan|nmap|zgrab|acunetix|nessus|dirbuster|wpscan) [NC]
RewriteRule ^ - [F,L]

ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

# --- 5. En-têtes de sécurité ---
<IfModule mod_headers.c>
  # HTTPS obligatoire pendant 2 ans (n'activez "preload" qu'une fois le SSL stable sur www et sans www)
  # (envoyé sans condition : les navigateurs l'ignorent en HTTP, et LiteSpeed ne gère pas toujours env=HTTPS)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  # Politique de contenu stricte : aucun script ni style externe, aucune injection possible.
  # Si vous activez Meta Pixel ou Google Analytics, remplacez cette ligne par la version commentée plus bas.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; manifest-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # Version avec Meta Pixel + Google Analytics :
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net https://www.googletagmanager.com; style-src 'self'; img-src 'self' data: https://www.facebook.com https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; media-src 'self'; connect-src 'self' https://www.facebook.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.google.com https://maps.google.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# --- 6. Types de fichiers ---
AddType image/webp .webp
AddType video/webm .webm
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .webmanifest .xml

# --- 7. Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# --- 8. Cache navigateur ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML, CSS et JS ne sont pas versionnés : le navigateur revérifie à chaque visite (réponse 304 légère),
  # donc une mise à jour du site est visible immédiatement, sans vider le cache.
  <FilesMatch "\.(html|css|js|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
